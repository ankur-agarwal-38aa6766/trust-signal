-- Only GLEIF egress. Unsupported accounts must use restricted initialization.
CREATE SCHEMA IF NOT EXISTS TRUST_SIGNAL_SECRETS;
CREATE NETWORK RULE IF NOT EXISTS TRUST_SIGNAL_SECRETS.GLEIF_EGRESS
    MODE = EGRESS TYPE = HOST_PORT VALUE_LIST = ('api.gleif.org:443');
CREATE EXTERNAL ACCESS INTEGRATION IF NOT EXISTS {eai}
    ALLOWED_NETWORK_RULES = ({database}.TRUST_SIGNAL_SECRETS.GLEIF_EGRESS) ENABLED = TRUE;
DESCRIBE NETWORK RULE TRUST_SIGNAL_SECRETS.GLEIF_EGRESS;
DESCRIBE INTEGRATION {eai};
