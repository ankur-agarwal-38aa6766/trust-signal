-- Execute separately as an authorized administrator; creates no warehouse.
CREATE ROLE IF NOT EXISTS {role};
GRANT ROLE {role} TO ROLE SYSADMIN;
GRANT EXECUTE TASK ON ACCOUNT TO ROLE {role};
GRANT USAGE ON DATABASE {database} TO ROLE {role};
GRANT USAGE ON WAREHOUSE {warehouse} TO ROLE {role};
GRANT USAGE, CREATE TASK, CREATE PROCEDURE ON SCHEMA {ops} TO ROLE {role};
GRANT USAGE ON SCHEMA {raw} TO ROLE {role};
GRANT USAGE ON SCHEMA {core} TO ROLE {role};
GRANT READ, WRITE ON STAGE {ops}.WORKFLOW_CODE TO ROLE {role};
GRANT SELECT, UPDATE ON TABLE {core}.CASE_REQUESTS TO ROLE {role};
GRANT SELECT, INSERT, UPDATE ON TABLE {ops}.CASE_RUNS TO ROLE {role};
GRANT SELECT, INSERT, UPDATE ON TABLE {ops}.STAGE_ATTEMPTS TO ROLE {role};
GRANT SELECT, INSERT, UPDATE ON TABLE {ops}.SOURCE_RUNS TO ROLE {role};
GRANT SELECT, INSERT ON TABLE {raw}.SOURCE_OBSERVATIONS TO ROLE {role};
GRANT SELECT, INSERT ON TABLE {raw}.SOURCE_RESPONSE_CHUNKS TO ROLE {role};
-- No workflow-procedure privileges are granted to PUBLIC or the UI role.
