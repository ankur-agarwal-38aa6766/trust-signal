-- One reusable graph, one queued case per run; no overlapping graph instances.
CREATE OR REPLACE TASK {ops}.TS_CLAIM WAREHOUSE = {warehouse}
SCHEDULE = '1 MINUTE' OVERLAP_POLICY = NO_OVERLAP
TASK_AUTO_RETRY_ATTEMPTS = 2 SUSPEND_TASK_AFTER_NUM_FAILURES = 3
USER_TASK_TIMEOUT_MS = 900000 AS EXECUTE IMMEDIATE $$
DECLARE run_id VARCHAR; graph_id VARCHAR;
BEGIN
    graph_id := (SELECT SYSTEM$TASK_RUNTIME_INFO('CURRENT_TASK_GRAPH_RUN_GROUP_ID'));
    CALL {ops}.CLAIM_WORKFLOW(:graph_id) INTO :run_id;
    CALL SYSTEM$SET_RETURN_VALUE(:run_id);
END;
$$;
