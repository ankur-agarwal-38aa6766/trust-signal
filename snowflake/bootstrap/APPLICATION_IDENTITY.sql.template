-- Administrator-reviewed DEV setup. Replace the public key placeholder only.
-- Never put a private key or passphrase in this file.
USE ROLE ACCOUNTADMIN;
CREATE ROLE IF NOT EXISTS TRUST_SIGNAL_INGESTOR;
GRANT USAGE ON WAREHOUSE TRUST_SIGNAL_PIPELINE_WH TO ROLE TRUST_SIGNAL_INGESTOR;
GRANT USAGE ON DATABASE TRUST_SIGNAL_DEV TO ROLE TRUST_SIGNAL_INGESTOR;
GRANT USAGE ON SCHEMA TRUST_SIGNAL_DEV.TRUST_SIGNAL_RAW TO ROLE TRUST_SIGNAL_INGESTOR;
GRANT USAGE ON SCHEMA TRUST_SIGNAL_DEV.TRUST_SIGNAL_OPS TO ROLE TRUST_SIGNAL_INGESTOR;
GRANT SELECT, INSERT ON TABLE TRUST_SIGNAL_DEV.TRUST_SIGNAL_RAW.SOURCE_OBSERVATIONS
    TO ROLE TRUST_SIGNAL_INGESTOR;
GRANT SELECT, INSERT, UPDATE ON TABLE TRUST_SIGNAL_DEV.TRUST_SIGNAL_OPS.SOURCE_RUNS
    TO ROLE TRUST_SIGNAL_INGESTOR;
CREATE USER TRUST_SIGNAL_INGEST_SVC
    TYPE = SERVICE
    RSA_PUBLIC_KEY = '<PUBLIC_KEY_BASE64>'
    DEFAULT_ROLE = TRUST_SIGNAL_INGESTOR
    DEFAULT_WAREHOUSE = TRUST_SIGNAL_PIPELINE_WH;
GRANT ROLE TRUST_SIGNAL_INGESTOR TO USER TRUST_SIGNAL_INGEST_SVC;
GRANT ROLE TRUST_SIGNAL_INGESTOR TO ROLE SYSADMIN;
