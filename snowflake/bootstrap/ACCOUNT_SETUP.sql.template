CREATE DATABASE IF NOT EXISTS <TRUST_SIGNAL_DATABASE>;
CREATE WAREHOUSE IF NOT EXISTS <TRUST_SIGNAL_APP_WAREHOUSE>
  WAREHOUSE_SIZE = 'XSMALL'
  AUTO_SUSPEND = 60
  AUTO_RESUME = TRUE;
CREATE WAREHOUSE IF NOT EXISTS <TRUST_SIGNAL_PIPELINE_WAREHOUSE>
  WAREHOUSE_SIZE = 'XSMALL'
  AUTO_SUSPEND = 60
  AUTO_RESUME = TRUE;

CREATE ROLE IF NOT EXISTS TRUST_SIGNAL_PLATFORM_ADMIN;
CREATE ROLE IF NOT EXISTS TRUST_SIGNAL_DEPLOYER;
CREATE ROLE IF NOT EXISTS TRUST_SIGNAL_ORCHESTRATOR;
CREATE ROLE IF NOT EXISTS TRUST_SIGNAL_ANALYST;
CREATE ROLE IF NOT EXISTS TRUST_SIGNAL_CONNECTOR;
CREATE ROLE IF NOT EXISTS TRUST_SIGNAL_REVIEWER;

GRANT USAGE ON WAREHOUSE <TRUST_SIGNAL_APP_WAREHOUSE> TO ROLE TRUST_SIGNAL_ANALYST;
GRANT USAGE ON WAREHOUSE <TRUST_SIGNAL_APP_WAREHOUSE> TO ROLE TRUST_SIGNAL_REVIEWER;
GRANT USAGE ON WAREHOUSE <TRUST_SIGNAL_PIPELINE_WAREHOUSE> TO ROLE TRUST_SIGNAL_ORCHESTRATOR;
GRANT USAGE ON WAREHOUSE <TRUST_SIGNAL_PIPELINE_WAREHOUSE> TO ROLE TRUST_SIGNAL_CONNECTOR;

