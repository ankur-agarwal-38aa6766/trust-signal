# Share this template, never a populated .env or private keys.
TRUST_SIGNAL_ENV=local
TRUST_SIGNAL_PLATFORM=snowflake
TRUST_SIGNAL_FIXTURES_ENABLED=false

# Export this variable in your shell for live UK company profile checks.
COMPANIES_HOUSE_API_KEY=

# Supply the account owner's values. These names are examples, not required names.
TRUST_SIGNAL_SNOWFLAKE_ACCOUNT=YOUR_ORGANIZATION-YOUR_ACCOUNT
TRUST_SIGNAL_SNOWFLAKE_USER=TRUST_SIGNAL_INGEST_SVC
TRUST_SIGNAL_SNOWFLAKE_ROLE=TRUST_SIGNAL_INGESTOR
TRUST_SIGNAL_SNOWFLAKE_WAREHOUSE=TRUST_SIGNAL_PIPELINE_WH
TRUST_SIGNAL_SNOWFLAKE_DATABASE=TRUST_SIGNAL_DEV
TRUST_SIGNAL_SNOWFLAKE_SCHEMA=TRUST_SIGNAL_RAW
TRUST_SIGNAL_SNOWFLAKE_PRIVATE_KEY_FILE=.secrets/snowflake_key.p8
TRUST_SIGNAL_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE_FILE=.secrets/snowflake_key.pass
